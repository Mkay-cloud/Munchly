# Sanity (CMS) — from sanity.io/manage, your project's API settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Server-only, keep secret. Used later for write access (e.g. a "suggest a recipe" form).
SANITY_API_TOKEN=

# Supabase (auth + database) — from your Supabase project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, keep secret. The email you sign into Munchly with that
# should have access to /admin (reviewing community recipe submissions and
# edits). Must match the admin email baked into the community_recipes RLS
# policies in Supabase, or /admin will just say "not authorized".
ADMIN_EMAIL=

# Same value as ADMIN_EMAIL above, but public (visible in the browser).
# Used only to decide whether to show a "Review submissions" link in your
# account menu - it's not a security boundary, ADMIN_EMAIL and the RLS
# policies still do the real enforcement. Keep these two in sync.
NEXT_PUBLIC_ADMIN_EMAIL=

# Google Analytics — set this only in Vercel's Production environment (not
# Preview, not local dev), so test traffic doesn't pollute real analytics.
NEXT_PUBLIC_GA_ID=

# DeepL (machine translation) — from deepl.com/pro-api, free tier covers
# 500,000 characters/month. Used to translate Sanity recipe/blog content
# into the non-English locales; without it, those locales just show the
# original English content (no error, just no translation).
DEEPL_API_KEY=

# Server-only, keep secret. From your Supabase project's API settings (same
# page as NEXT_PUBLIC_SUPABASE_ANON_KEY above, a different key further down
# the page). Bypasses Row Level Security - used only server-side, to write
# cached recipe/blog translations to the content_translations table (see
# scripts/supabase-content-translations.sql). Never expose this to the
# browser (no NEXT_PUBLIC_ prefix, and it's never imported into client code).
SUPABASE_SERVICE_ROLE_KEY=
